# API port (default 3001)
PORT=3001

# PostgreSQL — required for imports, reconciliation, audit log, period close.
# Local Docker: postgresql://erps:erps@localhost:5432/erps
# DATABASE_URL=postgresql://erps:erps@localhost:5432/erps

# Use bundled mock data when DATABASE_URL is unset, or force mock with:
# USE_MOCK_FINANCE=true

# Production CORS — comma-separated SPA origins (Firebase Hosting, custom domain).
# CORS_ORIGINS=https://your-project.web.app,https://your-project.firebaseapp.com

# NODE_ENV=production
