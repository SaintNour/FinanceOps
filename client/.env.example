# Set to true to show the Reconciliation page in the sidebar
VITE_ENABLE_RECONCILIATION=false

# Production: backend base URL when the UI is on Firebase Hosting (no trailing slash).
# Example: https://us-central1-your-project.cloudfunctions.net/api
# Leave unset for local dev (Vite proxies /api to http://localhost:3001).
# VITE_API_BASE_URL=
